{
  // Cloudflare Worker: serves the app in ./public, plus /api/ask (Workers AI) for the Asisten
  "name": "ppic-forecast-desk",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "ai": { "binding": "AI" },
  // Branch preview builds (`wrangler preview`) need their own bindings
  "previews": { "ai": { "binding": "AI" } }
}
